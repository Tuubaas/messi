{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "messi-finance",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Everything lives in D1. No database_id on purpose: `wrangler deploy` creates the database
  // the first time and reuses it afterwards; `vp dev` uses a local copy in .wrangler/.
  "d1_databases": [{ "binding": "DB", "database_name": "messi-finance" }],
}
