{
  "name": "messi",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp test && vp run -r build",
    "dev": "vp run @messi/home#dev",
    "dev:games": "vp run @messi/games#dev",
    "dev:finance": "vp run @messi/finance#dev"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.6",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core",
      "@tanstack/react-router",
      "@tanstack/router-plugin"
    ],
    "exclude": [
      "*#lifecycle/*"
    ]
  }
}
